        function resolveLocation(query) {
            if (!query || !query.trim()) return null;
            const raw = query.trim();

            const zipMatch = raw.match(/(\d{3})\s*(\d{2})/);
            if (zipMatch) {
                const digits = `${zipMatch[1]}${zipMatch[2]}`;
                const exact = CZ_LOCATIONS.find(l => l.zip === digits);
                if (exact) {
                    return { label: `${exact.name} (${formatZip(digits)})`, lat: exact.lat, lon: exact.lon };
                }
                const pref = ZIP_PREFIX_FALLBACK.find(p => digits.startsWith(p.prefix));
                if (pref) {
                    const ref = CZ_LOCATIONS.find(c => c.name === pref.city);
                    if (ref) {
                        return { label: `PSČ ${formatZip(digits)} (${ref.name})`, lat: ref.lat, lon: ref.lon };
