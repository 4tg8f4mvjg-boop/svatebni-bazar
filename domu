        function renderColorSwatchesHtml(selectedList, mode) {
            return TAG_CONFIG.colors.map(c => {
                const isSelected = selectedList.includes(c.label);
                const strokeColor = c.light ? '#26221E' : '#FFFFFF';
                const clickHandler = mode === 'filter'
                    ? `toggleFilterTag('colors', '${c.label}')`
                    : `toggleFormColorSwatch('${c.label}')`;
                return `
                    <button type="button"
                            class="swatch-btn ${isSelected ? 'selected' : ''}"
                            style="background-color: ${c.hex};"
                            data-tooltip="${escapeHtml(c.label)}"
                            aria-label="${escapeHtml(c.label)}"
                            aria-pressed="${isSelected}"
                            onclick="${clickHandler}">
                        <svg class="swatch-check" viewBox="0 0 24 24" fill="none" stroke="${strokeColor}" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>
                `;
            }).join('');
        }

