        function renderFallbackSpdSvg(seedText) {
            let hash = 0;
            for (let i = 0; i < seedText.length; i++) {
                hash = ((hash << 5) - hash) + seedText.charCodeAt(i);
                hash |= 0;
            }
            const size = 21;
            const cell = 8;
            let rects = '';
            for (let r = 0; r < size; r++) {
                for (let c = 0; c < size; c++) {
                    const inFinder = (r < 7 && c < 7) || (r < 7 && c >= size - 7) || (r >= size - 7 && c < 7);
                    let filled = false;
                    if (inFinder) {
                        const lr = r >= size - 7 ? r - (size - 7) : r;
                        const lc = c >= size - 7 ? c - (size - 7) : c;
                        filled = lr === 0 || lr === 6 || lc === 0 || lc === 6 || (lr >= 2 && lr <= 4 && lc >= 2 && lc <= 4);
                    } else {
                        filled = (((hash >> ((r * 3 + c) % 24)) ^ (r * 7 + c * 13)) & 1) === 1;
                    }
                    if (filled) {
                        rects += `<rect x="${c * cell}" y="${r * cell}" width="${cell}" height="${cell}" fill="#26221E"/>`;
                    }
                }
            }
            return `<svg viewBox="0 0 ${size * cell} ${size * cell}" width="176" height="176" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="#FFFFFF"/>${rects}</svg>`;
        }

