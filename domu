        function pad2(n) {
            return n < 10 ? `0${n}` : `${n}`;
        }

        function buildCalendarHtml({ year, month, bookedDates = [], selectedDates = [], mode = 'detail' }) {
            const firstDay = new Date(year, month, 1);
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            // Pondělí = 0 ... Neděle = 6
            const startOffset = (firstDay.getDay() + 6) % 7;

            let cells = '';
            for (let i = 0; i < startOffset; i++) {
                cells += `<div class="cal-day empty"></div>`;
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const iso = `${year}-${pad2(month + 1)}-${pad2(d)}`;
                const weekday = (startOffset + d - 1) % 7;
                const isWeekend = weekday >= 4; // Pá, So, Ne
                const isBooked = bookedDates.includes(iso);
                const isSelected = selectedDates.includes(iso);

                let cls = 'cal-day';
                if (isWeekend) cls += ' weekend';

                if (mode === 'owner') {
                    // Majitelka při vkládání klikáním označuje obsazené dny
                    cls += isBooked ? ' booked' : ' free';
                    cells += `<button type="button" class="${cls}" onclick="toggleOwnerBlockedDate('${iso}')" title="${isBooked ? 'Obsazeno (kliknutím uvolníte)' : 'Volné (kliknutím označíte jako obsazené)'}">${d}</button>`;
                } else {
                    // Zájemkyně v detailu vybírá volné dny pro rezervaci
                    if (isBooked) {
                        cls += ' booked locked';
                        cells += `<button type="button" class="${cls}" disabled title="Tento termín je již rezervován">${d}</button>`;
                    } else {
                        cls += isSelected ? ' selected' : ' free';
                        cells += `<button type="button" class="${cls}" onclick="toggleDetailSelectDate('${iso}')" title="Kliknutím vyberete termín">${d}</button>`;
                    }
                }
            }

            const navFn = mode === 'owner' ? 'changeOwnerCalMonth' : 'changeDetailCalMonth';

            return `
                <div class="cal-header">
                    <button type="button" class="cal-nav-btn" onclick="${navFn}(-1)" aria-label="Předchozí měsíc">‹</button>
                    <span class="cal-month-title">${MONTH_NAMES_CS[month]} ${year}</span>
                    <button type="button" class="cal-nav-btn" onclick="${navFn}(1)" aria-label="Další měsíc">›</button>
                </div>
                <div class="cal-weekdays">
                    <div>Po</div><div>Út</div><div>St</div><div>Čt</div><div>Pá</div><div>So</div><div>Ne</div>
                </div>
                <div class="cal-days-grid">${cells}</div>
                <div class="cal-legend">
                    <span><i class="legend-dot" style="background: var(--sage-badge); border: 1px solid rgba(58,87,69,0.3);"></i>Volný termín</span>
                    <span><i class="legend-dot" style="background: var(--danger-bg);"></i>Již obsazeno</span>
                    ${mode === 'detail' ? '<span><i class="legend-dot" style="background: var(--gold);"></i>Váš vybraný termín</span>' : ''}
                </div>
            `;
        }

