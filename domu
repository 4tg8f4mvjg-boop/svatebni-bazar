                }
            }

            const clean = stripAccents(raw.replace(/\(.*?\)/g, ''));
            if (!clean) return null;

            const found = CZ_LOCATIONS.find(l =>
                stripAccents(l.name).includes(clean) ||
                clean.includes(stripAccents(l.name)) ||
                l.aliases.some(a => a.includes(clean) || clean.includes(a))
            );

            return found ? { label: `${found.name} (${formatZip(found.zip)})`, lat: found.lat, lon: found.lon } : null;
        }

