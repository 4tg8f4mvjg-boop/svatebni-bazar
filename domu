<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moderní nevěsta | Lokální svatební bazar & garážové výprodeje</title>
    <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* =====================================================================
           DESIGN TOKENS & RESET - Značka MODERNÍ NEVĚSTA (#B98732)
           ===================================================================== */
        :root {
            --gold: #B98732;
            --gold-hover: #9F7124;
            --gold-tint: #F6EFE2;
            --gold-border: #E5D3B3;
            --gold-soft: rgba(185, 135, 50, 0.15);

            --bg-page: #FAF8F5;
            --bg-surface: #FFFFFF;
            --bg-subtle: #F3EDE4;
            --border-light: #EAE3D8;
            --border-medium: #DCD2C3;

            --text-primary: #26221E;
            --text-secondary: #6E665F;
            --text-muted: #968D84;

            --sage-badge: #EDF3EE;
            --sage-text: #3A5745;
            --terra-badge: #F9ECE8;
            --terra-text: #9B4C36;
            --danger-bg: #FDECEC;
            --danger-text: #B43838;

            --font-serif: 'Cormorant Garamond', Georgia, serif;
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

            --radius-sm: 10px;
            --radius-md: 16px;
            --radius-lg: 22px;
            --radius-xl: 28px;
            --radius-pill: 9999px;

            --shadow-xs: 0 2px 8px rgba(38, 34, 30, 0.04);
            --shadow-sm: 0 6px 20px rgba(38, 34, 30, 0.06);
            --shadow-md: 0 14px 36px rgba(38, 34, 30, 0.11);
            --shadow-gold: 0 8px 22px rgba(185, 135, 50, 0.25);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-page);
            color: var(--text-primary);
            line-height: 1.55;
            min-height: 100vh;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        button, input, select, textarea {
            font-family: inherit;
            color: inherit;
        }

        button {
            cursor: pointer;
            border: none;
            background: none;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .container {
            width: 100%;
            max-width: 1320px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* =====================================================================
           HEADER & BRAND LOGO ("mn - MODERNÍ NEVĚSTA")
           ===================================================================== */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 40;
            background: rgba(250, 248, 245, 0.94);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-light);
        }

        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            min-height: 76px;
            padding: 10px 0;
            flex-wrap: wrap;
        }

        .brand-link {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            color: var(--text-primary);
        }

        .brand-mark {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            background: var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-gold);
            flex-shrink: 0;
        }

        .brand-text-wrap {
            display: flex;
            flex-direction: column;
        }

        .brand-title {
            font-family: var(--font-serif);
            font-size: 1.48rem;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: 0.02em;
            color: var(--text-primary);
        }

        .brand-subtitle {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--gold);
            margin-top: 2px;
        }

        .main-nav {
            display: flex;
            align-items: center;
            background: var(--bg-subtle);
            padding: 5px;
            border-radius: var(--radius-pill);
            border: 1px solid var(--border-light);
            gap: 4px;
        }

        .nav-tab {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            border-radius: var(--radius-pill);
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-secondary);
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .nav-tab:hover {
            color: var(--text-primary);
        }

        .nav-tab.active {
            background: var(--bg-surface);
            color: var(--text-primary);
            box-shadow: var(--shadow-xs);
        }

        .nav-pill-count {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: var(--radius-pill);
            background: var(--gold-tint);
            color: var(--gold-hover);
            border: 1px solid var(--gold-border);
        }

        .btn-gold {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--gold);
            color: #FFFFFF;
            font-size: 0.86rem;
            font-weight: 600;
            padding: 11px 20px;
            border-radius: var(--radius-pill);
            box-shadow: var(--shadow-gold);
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-gold:hover:not(:disabled) {
            background: var(--gold-hover);
            transform: translateY(-1px);
        }

        .btn-gold:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            box-shadow: none;
        }

        .btn-outline-gold {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--gold-tint);
            color: var(--gold-hover);
            border: 1px solid var(--gold-border);
            font-size: 0.84rem;
            font-weight: 600;
            padding: 9px 16px;
            border-radius: var(--radius-pill);
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-outline-gold:hover {
            background: var(--gold);
            color: #FFFFFF;
            border-color: var(--gold);
        }

        /* =====================================================================
           HERO BANNER
           ===================================================================== */
        .hero-section {
            padding: 32px 0 22px;
            text-align: center;
        }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            color: var(--gold-hover);
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            padding: 6px 14px;
            border-radius: var(--radius-pill);
            margin-bottom: 12px;
        }

        .hero-title {
            font-family: var(--font-serif);
            font-size: clamp(2rem, 3.8vw, 3rem);
            font-weight: 600;
            line-height: 1.15;
            color: var(--text-primary);
            max-width: 780px;
            margin: 0 auto 10px;
        }

        .hero-title em {
            font-style: italic;
            color: var(--gold);
            font-weight: 600;
        }

        .hero-desc {
            font-size: 0.96rem;
            color: var(--text-secondary);
            max-width: 660px;
            margin: 0 auto;
        }

        /* =====================================================================
           SEARCH & LOCALIZATION BAR
           ===================================================================== */
        .search-panel {
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-xl);
            padding: 22px 24px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 26px;
        }

        .search-grid {
            display: grid;
            grid-template-columns: 1.3fr 1fr 1.55fr;
            gap: 18px;
            align-items: end;
        }

        .field-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
            min-width: 0;
        }

        .field-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            font-size: 0.74rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-secondary);
        }

        .field-label-accent {
            color: var(--gold-hover);
            font-weight: 700;
            text-transform: none;
            letter-spacing: 0;
            font-size: 0.78rem;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon-left {
            position: absolute;
            left: 14px;
            color: var(--gold);
            pointer-events: none;
            display: flex;
        }

        .text-input {
            width: 100%;
            height: 44px;
            background: var(--bg-page);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-md);
            padding: 0 36px 0 40px;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-primary);
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .text-input:focus {
            outline: none;
            border-color: var(--gold);
            background: var(--bg-surface);
            box-shadow: 0 0 0 3px var(--gold-soft);
        }

        .clear-input-btn {
            position: absolute;
            right: 10px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            background: var(--bg-subtle);
        }

        .clear-input-btn.visible {
            display: flex;
        }

        .range-box {
            height: 44px;
            background: var(--bg-page);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-md);
            padding: 0 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .range-slider {
            width: 100%;
            accent-color: var(--gold);
            cursor: pointer;
            height: 6px;
        }

        .segmented-control {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 4px;
            background: var(--bg-page);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-md);
            padding: 4px;
            min-height: 44px;
        }

        .seg-btn {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-secondary);
            border-radius: 11px;
            padding: 6px 6px;
            transition: all 0.2s ease;
            text-align: center;
            line-height: 1.2;
        }

        .seg-btn:hover {
            color: var(--text-primary);
        }

        .seg-btn.active {
            background: var(--gold);
            color: #FFFFFF;
            box-shadow: 0 2px 8px rgba(185, 135, 50, 0.28);
        }

        .search-secondary-row {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
        }

        .quick-cities {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .quick-label {
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-right: 2px;
        }

        .city-chip {
            font-size: 0.77rem;
            font-weight: 500;
            padding: 5px 12px;
            border-radius: var(--radius-pill);
            background: var(--bg-page);
            border: 1px solid var(--border-light);
            color: var(--text-secondary);
            transition: all 0.18s ease;
        }

        .city-chip:hover, .city-chip.active {
            background: var(--gold-tint);
            border-color: var(--gold-border);
            color: var(--gold-hover);
            font-weight: 600;
        }

        .fulltext-box {
            width: 100%;
            max-width: 340px;
        }

        /* =====================================================================
           MAIN CATALOG LAYOUT (Sidebar Filters + Listings Grid)
           ===================================================================== */
        .catalog-layout {
            display: grid;
            grid-template-columns: 300px minmax(0, 1fr);
            gap: 26px;
            align-items: start;
            padding-bottom: 64px;
        }

        .filters-sidebar {
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-xl);
            padding: 22px;
            box-shadow: var(--shadow-xs);
            position: sticky;
            top: 94px;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding-bottom: 14px;
            margin-bottom: 18px;
            border-bottom: 1px solid var(--border-light);
        }

        .sidebar-title {
            font-family: var(--font-serif);
            font-size: 1.35rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .filter-badge-count {
            display: none;
            align-items: center;
            justify-content: center;
            min-width: 22px;
            height: 22px;
            padding: 0 6px;
            border-radius: var(--radius-pill);
            background: var(--gold);
            color: #FFFFFF;
            font-family: var(--font-sans);
            font-size: 0.72rem;
            font-weight: 700;
        }

        .filter-badge-count.visible {
            display: inline-flex;
        }

        .reset-link {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--gold-hover);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .filter-group {
            margin-bottom: 20px;
        }

        .filter-group:last-child {
            margin-bottom: 0;
        }

        .filter-group-title {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-secondary);
            margin-bottom: 10px;
        }

        .tag-cloud {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .tag-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 12px;
            border-radius: var(--radius-pill);
            font-size: 0.8rem;
            font-weight: 500;
            background: var(--bg-page);
            border: 1px solid var(--border-light);
            color: var(--text-secondary);
            transition: all 0.16s ease;
            text-align: left;
            line-height: 1.25;
        }

        .tag-pill:hover {
            border-color: var(--gold-border);
            color: var(--text-primary);
            background: var(--gold-tint);
        }

        .tag-pill.selected {
            background: var(--gold);
            border-color: var(--gold);
            color: #FFFFFF;
            font-weight: 600;
            box-shadow: 0 3px 10px rgba(185, 135, 50, 0.24);
        }

        .color-swatch {
            width: 13px;
            height: 13px;
            border-radius: 50%;
            flex-shrink: 0;
            border: 1px solid rgba(0, 0, 0, 0.16);
        }

        .tag-pill.selected .color-swatch {
            border-color: #FFFFFF;
        }

        /* Grafické barevné čtverečky bez slov (swatches v levém filtru i ve formuláři) */
        .swatch-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .swatch-btn {
            position: relative;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1.5px solid rgba(38, 34, 30, 0.16);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
            flex-shrink: 0;
        }

        .swatch-btn:hover {
            transform: translateY(-2px) scale(1.06);
            box-shadow: 0 5px 12px rgba(38, 34, 30, 0.16);
            z-index: 2;
        }

        .swatch-btn::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: calc(100% + 7px);
            left: 50%;
            transform: translateX(-50%) translateY(3px);
            background: var(--text-primary);
            color: #FFFFFF;
            font-size: 0.71rem;
            font-weight: 600;
            white-space: nowrap;
            padding: 4px 9px;
            border-radius: 6px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.15s ease, transform 0.15s ease;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18);
        }

        .swatch-btn:hover::after {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .swatch-btn.selected {
            border: 2.5px solid var(--gold);
            box-shadow: 0 0 0 2.5px #FFFFFF, 0 0 0 4.5px var(--gold), 0 6px 14px rgba(185, 135, 50, 0.28);
            transform: scale(1.04);
        }

        .swatch-check {
            display: none;
            width: 15px;
            height: 15px;
        }

        .swatch-btn.selected .swatch-check {
            display: block;
        }

        .custom-style-box {
            margin-top: 10px;
            padding: 11px 13px;
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-sm);
            display: none;
            flex-direction: column;
            gap: 6px;
        }

        .custom-style-box.visible {
            display: flex;
        }

        .catalog-main {
            min-width: 0;
        }

        .results-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .results-heading {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .results-count-muted {
            font-family: var(--font-sans);
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--text-secondary);
            margin-left: 6px;
        }

        .sort-select {
            height: 38px;
            background: var(--bg-surface);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-pill);
            padding: 0 14px;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-primary);
            cursor: pointer;
        }

        .active-tags-strip {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 7px;
            margin-bottom: 16px;
        }

        .active-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            color: var(--gold-hover);
            font-size: 0.77rem;
            font-weight: 600;
            padding: 4px 11px;
            border-radius: var(--radius-pill);
        }

        .active-chip button {
            display: inline-flex;
            color: var(--gold-hover);
            font-weight: 700;
            font-size: 0.9rem;
            line-height: 1;
        }

        /* =====================================================================
           LISTING CARDS GRID
           ===================================================================== */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(295px, 1fr));
            gap: 20px;
        }

        .listing-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-xs);
            display: flex;
            flex-direction: column;
            transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            cursor: pointer;
        }

        .listing-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: var(--gold-border);
        }

        .listing-card.is-top {
            border-color: var(--gold-border);
            box-shadow: 0 6px 22px rgba(185, 135, 50, 0.11);
        }

        .card-visual {
            position: relative;
            height: 195px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-bottom: 1px solid var(--border-light);
        }

        .card-visual img.card-photo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

        .listing-card:hover .card-visual img.card-photo {
            transform: scale(1.04);
        }

        .card-visual-svg {
            width: 112px;
            height: 112px;
            opacity: 0.92;
            transition: transform 0.35s ease;
        }

        .listing-card:hover .card-visual-svg {
            transform: scale(1.06);
        }

        .card-badges-top {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            pointer-events: none;
        }

        .type-badge {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 5px 11px;
            border-radius: var(--radius-pill);
            letter-spacing: 0.02em;
            backdrop-filter: blur(6px);
        }

        .type-prodej {
            background: var(--sage-badge);
            color: var(--sage-text);
            border: 1px solid rgba(58, 87, 69, 0.2);
        }

        .type-pujceni {
            background: var(--terra-badge);
            color: var(--terra-text);
            border: 1px solid rgba(155, 76, 54, 0.2);
        }

        .type-kompletni {
            background: var(--gold-tint);
            color: var(--gold-hover);
            border: 1px solid var(--gold-border);
        }

        .top-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: var(--gold);
            color: #FFFFFF;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            padding: 4px 10px;
            border-radius: var(--radius-pill);
            box-shadow: 0 2px 8px rgba(185, 135, 50, 0.35);
        }

        .card-location-pill {
            position: absolute;
            bottom: 10px;
            left: 12px;
            right: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
        }

        .location-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid var(--border-light);
            color: var(--text-primary);
            font-size: 0.74rem;
            font-weight: 600;
            padding: 5px 11px;
            border-radius: var(--radius-pill);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            max-width: 100%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .location-dist {
            color: var(--gold-hover);
            font-weight: 700;
        }

        .card-body {
            padding: 18px 20px 20px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .card-meta-line {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            font-size: 0.74rem;
            font-weight: 600;
            color: var(--gold-hover);
            margin-bottom: 6px;
        }

        .card-title {
            font-family: var(--font-serif);
            font-size: 1.28rem;
            font-weight: 700;
            line-height: 1.25;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .listing-card:hover .card-title {
            color: var(--gold-hover);
        }

        .bundle-preview {
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-sm);
            padding: 9px 12px;
            margin-bottom: 10px;
        }

        .bundle-preview-head {
            font-size: 0.73rem;
            font-weight: 700;
            color: var(--gold-hover);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .bundle-preview-list {
            list-style: none;
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        .bundle-preview-list li {
            position: relative;
            padding-left: 12px;
            line-height: 1.35;
        }

        .bundle-preview-list li::before {
            content: "•";
            position: absolute;
            left: 2px;
            color: var(--gold);
            font-weight: 700;
        }

        .card-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-bottom: 10px;
        }

        .mini-tag {
            font-size: 0.71rem;
            font-weight: 500;
            padding: 3px 9px;
            border-radius: 7px;
            background: var(--bg-page);
            border: 1px solid var(--border-light);
            color: var(--text-secondary);
        }

        .card-excerpt {
            font-size: 0.82rem;
            color: var(--text-secondary);
            line-height: 1.48;
            margin-bottom: 16px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
        }

        .card-footer {
            padding-top: 14px;
            border-top: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .price-block {
            display: flex;
            align-items: baseline;
            gap: 5px;
            flex-wrap: wrap;
        }

        .price-value {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .price-unit {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .discount-pill {
            font-size: 0.69rem;
            font-weight: 700;
            background: var(--sage-badge);
            color: var(--sage-text);
            padding: 2px 7px;
            border-radius: var(--radius-pill);
        }

        .card-cta {
            font-size: 0.79rem;
            font-weight: 600;
            color: var(--gold-hover);
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            padding: 7px 14px;
            border-radius: var(--radius-pill);
            transition: all 0.18s ease;
        }

        .listing-card:hover .card-cta {
            background: var(--gold);
            border-color: var(--gold);
            color: #FFFFFF;
        }

        .empty-state {
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-xl);
            padding: 48px 24px;
            text-align: center;
            display: none;
        }

        .empty-state.visible {
            display: block;
        }

        /* =====================================================================
           GARAGE SALES VIEW ("Garážové výprodeje naživo")
           ===================================================================== */
        .garage-section {
            display: none;
            padding-bottom: 64px;
        }

        .garage-section.visible {
            display: block;
        }

        .garage-hero-card {
            background: var(--bg-surface);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-xl);
            padding: 28px 32px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
            box-shadow: var(--shadow-sm);
        }

        .garage-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 22px;
        }

        .event-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: var(--shadow-xs);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 18px;
        }

        .event-date-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.76rem;
            font-weight: 700;
            color: var(--gold-hover);
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            padding: 5px 12px;
            border-radius: var(--radius-pill);
            margin-bottom: 10px;
        }

        .event-meta {
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 0.84rem;
            color: var(--text-secondary);
            margin: 12px 0;
            padding: 12px;
            background: var(--bg-page);
            border-radius: var(--radius-md);
        }

        .tables-meter {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.82rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .meter-bar {
            height: 8px;
            background: var(--bg-subtle);
            border-radius: var(--radius-pill);
            overflow: hidden;
            margin-bottom: 14px;
        }

        .meter-fill {
            height: 100%;
            background: var(--gold);
            border-radius: var(--radius-pill);
            transition: width 0.3s ease;
        }

        .vendor-promo-box {
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-md);
            padding: 13px 14px;
            margin-top: 12px;
        }

        .vendor-promo-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--gold-hover);
            margin-bottom: 4px;
        }

        .vendor-promo-text {
            font-size: 0.78rem;
            color: var(--text-secondary);
            line-height: 1.45;
            margin-bottom: 10px;
        }

        .event-vendors-box {
            background: var(--bg-page);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 12px 14px;
            margin-top: 10px;
        }

        .event-vendors-title {
            font-size: 0.74rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-secondary);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .event-vendor-item {
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-sm);
            padding: 8px 10px;
            margin-bottom: 6px;
            font-size: 0.79rem;
        }

        .event-vendor-item:last-child {
            margin-bottom: 0;
        }

        .vendor-cat-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 4px;
        }

        .vendor-cat-badge {
            font-size: 0.67rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: var(--radius-pill);
            background: var(--sage-badge);
            color: var(--sage-text);
        }

        .venue-partner-banner {
            background: linear-gradient(135deg, var(--gold-tint) 0%, #FFFFFF 100%);
            border: 1.5px solid var(--gold-border);
            border-radius: var(--radius-xl);
            padding: 26px 30px;
            margin-top: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
            box-shadow: var(--shadow-sm);
        }

        .venue-partner-benefits {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 12px;
        }

        .benefit-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-primary);
            background: var(--bg-surface);
            border: 1px solid var(--gold-border);
            padding: 5px 12px;
            border-radius: var(--radius-pill);
        }

        .email-preview-card {
            background: var(--bg-page);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-md);
            padding: 16px 18px;
            margin-bottom: 14px;
        }

        .email-preview-meta {
            font-size: 0.78rem;
            color: var(--text-secondary);
            padding-bottom: 10px;
            margin-bottom: 10px;
            border-bottom: 1px dashed var(--border-medium);
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .email-preview-content {
            font-size: 0.83rem;
            color: var(--text-primary);
            white-space: pre-line;
            line-height: 1.55;
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-sm);
            padding: 12px 14px;
        }

        /* =====================================================================
           MODALS & SMART ADD LISTING FORM
           ===================================================================== */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 60;
            background: rgba(38, 34, 30, 0.58);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 18px;
            overflow-y: auto;
        }

        .modal-backdrop.open {
            display: flex;
        }

        .modal-dialog {
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-xl);
            width: 100%;
            max-width: 760px;
            max-height: 92vh;
            overflow-y: auto;
            box-shadow: var(--shadow-md);
            position: relative;
        }

        .modal-header {
            padding: 20px 26px 16px;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            position: sticky;
            top: 0;
            background: var(--bg-surface);
            z-index: 5;
        }

        .modal-title {
            font-family: var(--font-serif);
            font-size: 1.65rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .modal-close {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--bg-page);
            border: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
        }

        .modal-close:hover {
            background: var(--gold-tint);
            color: var(--gold-hover);
        }

        .modal-body {
            padding: 22px 26px 28px;
        }

        .form-section-card {
            background: var(--bg-page);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 18px;
            margin-bottom: 16px;
        }

        .form-section-heading {
            font-family: var(--font-serif);
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .form-full {
            grid-column: 1 / -1;
        }

        .form-input, .form-select, .form-textarea {
            width: 100%;
            background: var(--bg-surface);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-sm);
            padding: 10px 13px;
            font-size: 0.88rem;
            color: var(--text-primary);
        }

        .form-input:focus, .form-select:focus, .form-textarea:focus {
            outline: none;
            border-color: var(--gold);
            box-shadow: 0 0 0 3px var(--gold-soft);
        }

        /* Type Switcher inside Add Modal */
        .modal-type-tabs {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            margin-bottom: 18px;
        }

        .modal-type-btn {
            padding: 12px 10px;
            border-radius: var(--radius-md);
            border: 1.5px solid var(--border-medium);
            background: var(--bg-surface);
            text-align: center;
            transition: all 0.2s ease;
        }

        .modal-type-btn strong {
            display: block;
            font-size: 0.88rem;
            color: var(--text-primary);
        }

        .modal-type-btn span {
            display: block;
            font-size: 0.73rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .modal-type-btn.active {
            border-color: var(--gold);
            background: var(--gold-tint);
            box-shadow: 0 4px 12px rgba(185, 135, 50, 0.16);
        }

        .modal-type-btn.active strong {
            color: var(--gold-hover);
        }

        /* Drag & Drop Photo Compression Zone */
        .photo-dropzone {
            border: 2px dashed var(--gold-border);
            background: var(--bg-surface);
            border-radius: var(--radius-md);
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .photo-dropzone:hover, .photo-dropzone.dragover {
            border-color: var(--gold);
            background: var(--gold-tint);
        }

        .photo-previews-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
            gap: 10px;
            margin-top: 12px;
        }

        .photo-thumb-card {
            position: relative;
            border-radius: var(--radius-sm);
            overflow: hidden;
            border: 1px solid var(--border-medium);
            background: var(--bg-surface);
        }

        .photo-thumb-card img {
            width: 100%;
            height: 105px;
            object-fit: cover;
        }

        .photo-savings-badge {
            font-size: 0.67rem;
            font-weight: 600;
            padding: 5px 7px;
            background: var(--sage-badge);
            color: var(--sage-text);
            line-height: 1.25;
        }

        .photo-main-tag {
            position: absolute;
            top: 6px;
            left: 6px;
            background: var(--gold);
            color: #FFFFFF;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: var(--radius-pill);
        }

        .photo-remove-btn {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: rgba(38, 34, 30, 0.78);
            color: #FFFFFF;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Bundle Items Repeater */
        .bundle-row {
            display: grid;
            grid-template-columns: 84px minmax(0, 1fr) 36px;
            gap: 8px;
            margin-bottom: 8px;
            align-items: center;
        }

        /* Checkbox Pills in Modal */
        .checkbox-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .check-pill-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: var(--radius-pill);
            background: var(--bg-surface);
            border: 1px solid var(--border-medium);
            font-size: 0.79rem;
            cursor: pointer;
            user-select: none;
            transition: all 0.15s ease;
        }

        .check-pill-label:hover {
            border-color: var(--gold);
        }

        .check-pill-label input {
            accent-color: var(--gold);
        }

        .delivery-distance-box {
            margin-top: 10px;
            padding: 12px 14px;
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-sm);
            display: none;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .delivery-distance-box.visible {
            display: flex;
        }

        .top-upsell-box {
            background: var(--gold-tint);
            border: 1.5px solid var(--gold-border);
            border-radius: var(--radius-md);
            padding: 14px 16px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        /* =====================================================================
           INTERACTIVE RENTAL CALENDAR (Both in Add Form & Detail Modal)
           ===================================================================== */
        .calendar-widget {
            background: var(--bg-surface);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-md);
            padding: 16px;
        }

        .cal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 12px;
        }

        .cal-nav-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--bg-page);
            border: 1px solid var(--border-medium);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .cal-nav-btn:hover {
            background: var(--gold-tint);
            border-color: var(--gold);
            color: var(--gold-hover);
        }

        .cal-month-title {
            font-family: var(--font-serif);
            font-size: 1.25rem;
            font-weight: 700;
        }

        .cal-weekdays {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 4px;
            text-align: center;
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .cal-days-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 4px;
        }

        .cal-day {
            height: 36px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid transparent;
            transition: all 0.15s ease;
        }

        .cal-day.empty {
            pointer-events: none;
        }

        .cal-day.free {
            background: var(--sage-badge);
            color: var(--sage-text);
            border-color: rgba(58, 87, 69, 0.18);
        }

        .cal-day.free:hover {
            border-color: var(--gold);
            transform: scale(1.04);
        }

        .cal-day.weekend {
            font-weight: 700;
        }

        .cal-day.booked {
            background: var(--danger-bg);
            color: var(--danger-text);
            text-decoration: line-through;
            opacity: 0.82;
        }

        .cal-day.booked.locked {
            cursor: not-allowed;
        }

        .cal-day.selected {
            background: var(--gold) !important;
            color: #FFFFFF !important;
            border-color: var(--gold-hover) !important;
            box-shadow: 0 2px 8px rgba(185, 135, 50, 0.35);
        }

        .cal-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid var(--border-light);
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        .legend-dot {
            display: inline-block;
            width: 11px;
            height: 11px;
            border-radius: 3px;
            margin-right: 5px;
            vertical-align: middle;
        }

        /* Gallery thumbnails in Detail Modal */
        .detail-gallery-thumbs {
            display: flex;
            gap: 8px;
            margin-top: 8px;
            overflow-x: auto;
            padding-bottom: 4px;
        }

        .detail-thumb {
            width: 68px;
            height: 52px;
            border-radius: 8px;
            object-fit: cover;
            border: 2px solid transparent;
            cursor: pointer;
            flex-shrink: 0;
        }

        .detail-thumb.active {
            border-color: var(--gold);
        }

        /* Toast Notification */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 80;
            background: var(--text-primary);
            color: #FFFFFF;
            padding: 13px 20px;
            border-radius: var(--radius-pill);
            font-size: 0.85rem;
            font-weight: 500;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--gold);
            display: flex;
            align-items: center;
            gap: 10px;
            transform: translateY(120%);
            opacity: 0;
            transition: all 0.28s ease;
            max-width: calc(100vw - 48px);
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        /* =====================================================================
           QR PLATBA ZA TOP ZVÝRAZNĚNÍ (SPD FORMÁT)
           ===================================================================== */
        .qr-payment-layout {
            display: grid;
            grid-template-columns: 220px minmax(0, 1fr);
            gap: 20px;
            align-items: center;
            background: var(--bg-page);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-lg);
            padding: 20px;
            margin-bottom: 18px;
        }

        .qr-frame {
            background: #FFFFFF;
            border: 2px solid var(--gold);
            border-radius: var(--radius-md);
            padding: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-xs);
        }

        .qr-frame canvas, .qr-frame img {
            width: 176px;
            height: 176px;
            display: block;
        }

        .qr-caption {
            font-size: 0.69rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--gold-hover);
            margin-top: 8px;
            text-align: center;
        }

        .bank-details-list {
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .bank-detail-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: var(--bg-surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-sm);
            padding: 9px 13px;
            font-size: 0.84rem;
        }

        .bank-detail-label {
            color: var(--text-secondary);
            font-size: 0.77rem;
            font-weight: 600;
        }

        .bank-detail-val {
            font-weight: 700;
            color: var(--text-primary);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .copy-mini-btn {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--gold-hover);
            background: var(--gold-tint);
            border: 1px solid var(--gold-border);
            padding: 3px 8px;
            border-radius: 6px;
            transition: all 0.15s ease;
        }

        .copy-mini-btn:hover {
            background: var(--gold);
            color: #FFFFFF;
        }

        .detail-top-promo {
            background: linear-gradient(135deg, var(--gold-tint) 0%, #FFFFFF 100%);
            border: 1.5px solid var(--gold-border);
            border-radius: var(--radius-md);
            padding: 14px 16px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
        }

        /* =====================================================================
           RESPONSIVE BREAKPOINTS
           ===================================================================== */
        @media (max-width: 1024px) {
            .search-grid {
                grid-template-columns: 1fr 1fr;
            }
            .search-grid .field-group:last-child {
                grid-column: 1 / -1;
            }
            .catalog-layout {
                grid-template-columns: 1fr;
            }
            .filters-sidebar {
                position: static;
            }
        }

        @media (max-width: 680px) {
            .search-grid {
                grid-template-columns: 1fr;
            }
            .segmented-control {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
            .modal-type-tabs {
                grid-template-columns: 1fr;
            }
            .form-grid {
                grid-template-columns: 1fr;
            }
            .qr-payment-layout {
                grid-template-columns: 1fr;
            }
            .header-inner {
                justify-content: center;
            }
            .fulltext-box {
                max-width: 100%;
            }
        }
    </style>
    <!-- Lehká knihovna pro generování ostrého QR kódu (SPD bankovní platba) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>

    <!-- =====================================================================
         HLAVIČKA S LOGEM ZNAČKY MODERNÍ NEVĚSTA
         ===================================================================== -->
    <header class="site-header">
        <div class="container header-inner">
            <a href="#" class="brand-link" onclick="switchView('bazar'); return false;">
                <div class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 120 80" width="44" height="32" fill="none">
                        <path d="M 6,44 C 18,43 24,38 29,38 C 32,38 28,53 31,53 C 34,53 41,38 45,38 C 48,38 44,53 47,53 C 50,53 56,39 60,39 C 63,39 58,64 62,64 C 67,64 73,41 76,41 C 79,41 76,51 81,51 C 87,51 96,35 114,35"
                              stroke="#FFFFFF" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="brand-text-wrap">
                    <span class="brand-title">Moderní nevěsta</span>
                    <span class="brand-subtitle">Lokální bazar &amp; garážáky</span>
                </div>
            </a>

            <nav class="main-nav" aria-label="Hlavní navigace">
                <button type="button" id="tab-bazar" class="nav-tab active" onclick="switchView('bazar')">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    <span>Lokální bazar &amp; půjčovna</span>
                    <span id="header-count" class="nav-pill-count">10</span>
                </button>
                <button type="button" id="tab-garazaky" class="nav-tab" onclick="switchView('garazaky')">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <span>Garážové výprodeje naživo</span>
                </button>
            </nav>

            <button type="button" class="btn-gold" onclick="openAddModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <span>Přidat výzdobu</span>
            </button>
        </div>
    </header>

    <main class="container">
        <section class="hero-section">
            <div class="hero-kicker">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>Osobní vyzvednutí bez kurýrů a rozbitých váz</span>
            </div>
            <h1 class="hero-title">Svatební poklady <em>z vašeho okolí</em></h1>
            <p class="hero-desc">
                Pořiďte si sladěnou výzdobu od nevěst z vašeho okresu, rezervujte si termín půjčení slavobrány nebo nakupte kompletní svatbu v jedné krabici.
            </p>
        </section>

        <!-- =================================================================
             POHLED 1: LOKÁLNÍ BAZAR & PŮJČOVNA
             ================================================================= -->
        <div id="view-bazar">
            <section class="search-panel" aria-label="Vyhledávání podle lokality">
                <div class="search-grid">
                    <div class="field-group">
                        <label class="field-label" for="location-input">
                            <span>Město nebo PSČ</span>
                            <span id="location-status" class="field-label-accent">Celá ČR</span>
                        </label>
                        <div class="input-wrapper">
                            <span class="input-icon-left">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            </span>
                            <input type="text" id="location-input" class="text-input" placeholder="Např. Bystřice n. P., 593 01, Brno..." oninput="handleLocationChange()">
                            <button type="button" id="clear-loc-btn" class="clear-input-btn" title="Vymazat lokalitu" onclick="setQuickLocation('')">✕</button>
                        </div>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="distance-slider">
                            <span>Dojezdová vzdálenost</span>
                            <span id="distance-value" class="field-label-accent">do 40 km</span>
                        </label>
                        <div class="range-box">
                            <input type="range" id="distance-slider" class="range-slider" min="10" max="150" step="5" value="40" oninput="handleDistanceChange()">
                        </div>
                    </div>

                    <div class="field-group">
                        <span class="field-label">Typ nabídky</span>
                        <div class="segmented-control" role="group" aria-label="Typ nabídky">
                            <button type="button" class="seg-btn active" data-offer="all" onclick="setOfferFilter('all')">Vše</button>
                            <button type="button" class="seg-btn" data-offer="Prodej" onclick="setOfferFilter('Prodej')">Prodej</button>
                            <button type="button" class="seg-btn" data-offer="Půjčení" onclick="setOfferFilter('Půjčení')">Půjčení</button>
                            <button type="button" class="seg-btn" data-offer="Kompletní svatba" onclick="setOfferFilter('Kompletní svatba')">Kompletní svatba</button>
                        </div>
                    </div>
                </div>

                <div class="search-secondary-row">
                    <div class="quick-cities">
                        <span class="quick-label">Oblíbené lokality:</span>
                        <button type="button" class="city-chip" onclick="setQuickLocation('Bystřice nad Pernštejnem (593 01)')">Bystřice n. P. • 593 01</button>
                        <button type="button" class="city-chip" onclick="setQuickLocation('Žďár nad Sázavou (591 01)')">Žďár n. S. • 591 01</button>
                        <button type="button" class="city-chip" onclick="setQuickLocation('Brno (602 00)')">Brno • 602 00</button>
                        <button type="button" class="city-chip" onclick="setQuickLocation('Praha (110 00)')">Praha • 110 00</button>
                        <button type="button" class="city-chip" onclick="setQuickLocation('Olomouc (779 00)')">Olomouc • 779 00</button>
                        <button type="button" class="city-chip" onclick="setQuickLocation('Plzeň (301 00)')">Plzeň • 301 00</button>
                    </div>

                    <div class="input-wrapper fulltext-box">
                        <span class="input-icon-left">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        </span>
                        <input type="text" id="search-input" class="text-input" placeholder="Hledat vázy, slavobránu, běhoun..." oninput="renderCatalog()">
                    </div>
                </div>
            </section>

            <div class="catalog-layout">
                <!-- Levý panel s multi-choice filtry (generováno z TAG_CONFIG) -->
                <aside class="filters-sidebar" aria-label="Podrobné filtry">
                    <div class="sidebar-header">
                        <h2 class="sidebar-title">
                            <span>Filtry výzdoby</span>
                            <span id="active-filter-count" class="filter-badge-count">0</span>
                        </h2>
                        <button type="button" class="reset-link" onclick="resetAllFilters()">Vymazat filtry</button>
                    </div>

                    <div class="filter-group">
                        <div class="filter-group-title">Barevná paleta</div>
                        <div id="filter-colors" class="swatch-grid"></div>
                    </div>

                    <div class="filter-group">
                        <div class="filter-group-title">Styl svatby</div>
                        <div id="filter-styles" class="tag-cloud"></div>
                    </div>

                    <div class="filter-group">
                        <div class="filter-group-title">Materiál</div>
                        <div id="filter-materials" class="tag-cloud"></div>
                    </div>

                    <div class="filter-group">
                        <div class="filter-group-title">Využití na svatbě</div>
                        <div id="filter-uses" class="tag-cloud"></div>
                    </div>
                </aside>

                <div class="catalog-main">
                    <div class="results-toolbar">
                        <h2 class="results-heading">
                            Nabídky v okolí <span id="results-count" class="results-count-muted">(10 položek)</span>
                        </h2>
                        <select id="sort-select" class="sort-select" onchange="renderCatalog()" aria-label="Řazení nabídek">
                            <option value="recommended">Doporučené (TOP)</option>
                            <option value="distance">Nejbližší podle km</option>
                            <option value="price-asc">Cena: od nejnižší</option>
                            <option value="price-desc">Cena: od nejvyšší</option>
                        </select>
                    </div>

                    <div id="active-tags-strip" class="active-tags-strip"></div>

                    <div id="cards-grid" class="cards-grid"></div>

                    <div id="empty-state" class="empty-state">
                        <h3 style="font-family: var(--font-serif); font-size: 1.6rem; margin-bottom: 8px;">Žádná výzdoba neodpovídá zvoleným filtrům</h3>
                        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 18px;">Zkuste zvětšit dojezdovou vzdálenost v km nebo odebrat některý z vybraných tagů.</p>
                        <button type="button" class="btn-gold" onclick="resetAllFilters()">Zobrazit všechny nabídky</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- =================================================================
             POHLED 2: GARÁŽOVÉ VÝPRODEJE NAŽIVO
             ================================================================= -->
        <section id="view-garazaky" class="garage-section" aria-label="Garážové výprodeje naživo">
            <div class="garage-hero-card">
                <div style="max-width: 650px;">
                    <div class="hero-kicker" style="margin-bottom: 8px;">Komunitní pop-up setkání nevěst</div>
                    <h2 style="font-family: var(--font-serif); font-size: 2rem; font-weight: 700; line-height: 1.2; margin-bottom: 8px;">
                        Svatební garážové výprodeje naživo
                    </h2>
                    <p style="color: var(--text-secondary); font-size: 0.92rem;">
                        Pronajměte si prodejní stůl za <strong>290 Kč</strong> a prodejte celou svatební výzdobu během jediného nedělního dopoledne bez balení krabic. Budoucí nevěsty si vše prohlédnou naživo u výběrové kávy.
                    </p>
                    <p style="color: var(--gold-hover); font-size: 0.86rem; font-weight: 600; margin-top: 8px;">
                        ✦ Pořádáme výprodej svatebních věcí ve vaší lokalitě – chcete nevěstám ukázat svoje služby? Rezervujte si prezentační místo pro lokální dodavatele za 500 Kč (kávové vozíky, zmrzlina, sweetbar, tiskoviny, květiny či drobné služby).
                    </p>
                </div>
                <button type="button" class="btn-gold" onclick="openVenueModal()">
                    Chci uspořádat výprodej
                </button>
            </div>

            <div id="garage-grid" class="garage-grid"></div>

            <div class="venue-partner-banner">
                <div style="max-width: 680px;">
                    <div class="hero-kicker" style="margin-bottom: 8px;">Spolupráce pro majitele objektů &amp; koordinátory</div>
                    <h3 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 700; line-height: 1.2; margin-bottom: 8px;">
                        Máte svatební stodolu, statek nebo prostor? Uspořádejte u vás Svatební garážový výprodej
                    </h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem;">
                        Přiveďte k sobě desítky budoucích nevěst z okolí ještě před začátkem sezóny. Ukážete jim svůj prostor v živé atmosféře, propojíte je s lokálními dodavateli a postaráme se o kompletní propagaci i rezervační systém stolů.
                    </p>
                    <div class="venue-partner-benefits">
                        <span class="benefit-pill">✦ Propagace mezi nevěstami v kraji</span>
                        <span class="benefit-pill">✦ Prostor pro vaše profi dodavatele</span>
                        <span class="benefit-pill">✦ Online rezervace prodejních míst</span>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 8px;">
                    <button type="button" class="btn-gold" onclick="openVenueModal()">
                        Chci uspořádat výprodej →
                    </button>
                    <span style="font-size: 0.76rem; color: var(--text-muted);">Nezávazná poptávka termínu</span>
                </div>
            </div>
        </section>
    </main>

    <!-- =====================================================================
         MODÁL 1: DETAIL INZERÁTU A REZERVAČNÍ KALENDÁŘ PRONÁJMU
         ===================================================================== -->
    <div id="detail-modal" class="modal-backdrop" onclick="if(event.target === this) closeModal('detail-modal')">
        <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="detail-modal-title">
            <div class="modal-header">
                <h2 id="detail-modal-title" class="modal-title">Detail nabídky</h2>
                <button type="button" class="modal-close" onclick="closeModal('detail-modal')" aria-label="Zavřít">✕</button>
            </div>
            <div id="detail-modal-body" class="modal-body"></div>
        </div>
    </div>

    <!-- =====================================================================
         MODÁL 2: PŘIDÁNÍ NOVÉ VÝZDOBY DO BAZARU / PŮJČOVNY
         ===================================================================== -->
    <div id="add-modal" class="modal-backdrop" onclick="if(event.target === this) closeModal('add-modal')">
        <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="add-modal-title">
            <div class="modal-header">
                <h2 id="add-modal-title" class="modal-title">Přidat svatební výzdobu</h2>
                <button type="button" class="modal-close" onclick="closeModal('add-modal')" aria-label="Zavřít">✕</button>
            </div>
            <div class="modal-body">
                <form id="add-listing-form" onsubmit="submitNewListing(event)">
                    <div class="modal-type-tabs" role="group" aria-label="Typ inzerátu">
                        <button type="button" class="modal-type-btn active" data-add-type="Prodej" onclick="setAddModalType('Prodej')">
                            <strong>Prodej</strong>
                            <span>Jednorázový prodej</span>
                        </button>
                        <button type="button" class="modal-type-btn" data-add-type="Půjčení" onclick="setAddModalType('Půjčení')">
                            <strong>Půjčení</strong>
                            <span>Pronájem s kalendářem</span>
                        </button>
                        <button type="button" class="modal-type-btn" data-add-type="Kompletní svatba" onclick="setAddModalType('Kompletní svatba')">
                            <strong>Kompletní svatba</strong>
                            <span>Balíček v krabici</span>
                        </button>
                    </div>

                    <div class="form-section-card">
                        <div class="form-section-heading"><span>1. Základní popis &amp; fotografie</span></div>
                        <div class="form-grid">
                            <div class="field-group form-full">
                                <label class="field-label" for="new-title">Název nabídky *</label>
                                <input required type="text" id="new-title" class="form-input" placeholder="Např. Sada 20 skleněných váziček a zlatých svícnů">
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="new-wedding-size">Velikost svatby *</label>
                                <select id="new-wedding-size" class="form-select">
                                    <option value="do 30 hostů">do 30 hostů</option>
                                    <option value="30–60 hostů" selected>30–60 hostů</option>
                                    <option value="60–100 hostů">60–100 hostů</option>
                                    <option value="100+ hostů">100+ hostů</option>
                                </select>
                            </div>
                            <div class="field-group form-full">
                                <label class="field-label" for="new-desc">Popis stavu a rozměrů</label>
                                <textarea id="new-desc" rows="2" class="form-textarea" placeholder="Popište rozměry, stav po svatbě, počet kusů..."></textarea>
                            </div>
                            <div class="field-group form-full">
                                <span class="field-label">Fotografie (automatická optimalizace na max. 1200 px)</span>
                                <div id="photo-dropzone" class="photo-dropzone"
                                     onclick="document.getElementById('photo-file-input').click()"
                                     ondragover="handlePhotoDragOver(event)"
                                     ondragleave="handlePhotoDragLeave(event)"
                                     ondrop="handlePhotoDrop(event)">
                                    <div style="font-size: 0.86rem; font-weight: 600; color: var(--gold-hover);">📷 Klikněte pro výběr fotek nebo je sem přetáhněte</div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 3px;">Max. 6 fotografií • Zmenší se automaticky v prohlížeči</div>
                                </div>
                                <input type="file" id="photo-file-input" accept="image/*" multiple style="display: none;" onchange="handlePhotoFiles(this.files)">
                                <div id="photo-previews-grid" class="photo-previews-grid"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section-card">
                        <div class="form-section-heading">
                            <span id="dynamic-section-title">2. Parametry prodeje</span>
                            <span id="bundle-discount-live" class="field-label-accent"></span>
                        </div>

                        <div id="dyn-prodej" class="form-grid">
                            <div class="field-group">
                                <label class="field-label" for="new-price-sale">Prodejní cena (Kč) *</label>
                                <input type="number" id="new-price-sale" class="form-input" min="1" placeholder="890">
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="new-pcs-count">Počet kusů / sad</label>
                                <input type="text" id="new-pcs-count" class="form-input" placeholder="Např. 1 sada (24 ks)">
                            </div>
                            <div class="field-group form-full">
                                <label class="field-label" for="new-condition">Stav výzdoby</label>
                                <select id="new-condition" class="form-select">
                                    <option value="Jako nové (1× použité na svatbě)">Jako nové (1× použité na svatbě)</option>
                                    <option value="Nové, nepoužité">Nové, nepoužité</option>
                                    <option value="Drobné známky použití">Drobné známky použití</option>
                                </select>
                            </div>
                        </div>

                        <div id="dyn-pujceni" style="display: none;">
                            <div class="form-grid" style="margin-bottom: 12px;">
                                <div class="field-group">
                                    <label class="field-label" for="new-price-rent">Cena pronájmu (Kč) *</label>
                                    <input type="number" id="new-price-rent" class="form-input" min="1" placeholder="1200">
                                </div>
                                <div class="field-group">
                                    <label class="field-label" for="new-rent-period">Období pronájmu</label>
                                    <select id="new-rent-period" class="form-select">
                                        <option value="/ víkend (čt–po)">/ víkend (čt–po)</option>
                                        <option value="/ den">/ den</option>
                                        <option value="/ svatbu">/ svatbu</option>
                                    </select>
                                </div>
                                <div class="field-group form-full">
                                    <label class="field-label" for="new-deposit">Vratná kauce (Kč)</label>
                                    <input type="number" id="new-deposit" class="form-input" min="0" placeholder="1000">
                                </div>
                            </div>
                            <div class="field-group">
                                <span class="field-label">Kliknutím označte již obsazené dny v kalendáři:</span>
                                <div id="add-rental-calendar" class="calendar-widget"></div>
                            </div>
                        </div>

                        <div id="dyn-kompletni" style="display: none;">
                            <div class="form-grid" style="margin-bottom: 12px;">
                                <div class="field-group">
                                    <label class="field-label" for="new-price-bundle">Cena za celý balíček (Kč) *</label>
                                    <input type="number" id="new-price-bundle" class="form-input" min="1" placeholder="4500" oninput="updateBundleDiscountPreview()">
                                </div>
                                <div class="field-group">
                                    <label class="field-label" for="new-orig-price">Původní pořizovací cena (Kč)</label>
