           ===================================================================== */
        function renderSidebarFilters() {
            // Barvy
            document.getElementById('filter-colors').innerHTML = TAG_CONFIG.colors.map(c => `
                <button type="button" class="tag-pill" data-group="colors" data-value="${c.label}" onclick="toggleFilterTag('colors', '${c.label}')">
                    <span class="color-swatch" style="background-color: ${c.hex};"></span>
                    <span>${c.label}</span>
                </button>
            `).join('');

            // Styl svatby
            document.getElementById('filter-styles').innerHTML = TAG_CONFIG.styles.map(s => `
                <button type="button" class="tag-pill" data-group="styles" data-value="${s}" onclick="toggleFilterTag('styles', '${s}')">
                    <span>${s}</span>
                </button>
            `).join('');

            // Materiál
            document.getElementById('filter-materials').innerHTML = TAG_CONFIG.materials.map(m => `
                <button type="button" class="tag-pill" data-group="materials" data-value="${m}" onclick="toggleFilterTag('materials', '${m}')">
                    <span>${m}</span>
                </button>
            `).join('');

            // Využití
            document.getElementById('filter-uses').innerHTML = TAG_CONFIG.uses.map(u => `
                <button type="button" class="tag-pill" data-group="uses" data-value="${u}" onclick="toggleFilterTag('uses', '${u}')">
                    <span>${u}</span>
                </button>
            `).join('');
        }

        function toggleFilterTag(group, value) {
            const arr = state[group];
            const idx = arr.indexOf(value);
            if (idx > -1) {
                arr.splice(idx, 1);
            } else {
                arr.push(value);
            }
            syncFilterPillsUI();
            renderCatalog();
        }

        function syncFilterPillsUI() {
            document.querySelectorAll('.tag-pill').forEach(pill => {
                const group = pill.dataset.group;
                const val = pill.dataset.value;
                if (state[group] && state[group].includes(val)) {
                    pill.classList.add('selected');
                } else {
                    pill.classList.remove('selected');
                }
            });

            const totalActive = state.colors.length + state.styles.length + state.materials.length + state.uses.length;
            const badge = document.getElementById('active-filter-count');
            badge.textContent = totalActive;
            if (totalActive > 0) {
                badge.classList.add('visible');
            } else {
                badge.classList.remove('visible');
            }
        }

        /* =====================================================================
           7. LOKALITA (MĚSTO / PSČ), VZDÁLENOST & TYP NABÍDKY
           ===================================================================== */
        function handleLocationChange() {
            const val = document.getElementById('location-input').value;
            state.locationQuery = val;
            state.resolvedLoc = resolveLocation(val);

            const clearBtn = document.getElementById('clear-loc-btn');
            const statusEl = document.getElementById('location-status');

            if (val.trim()) {
                clearBtn.classList.add('visible');
            } else {
                clearBtn.classList.remove('visible');
            }

            if (state.resolvedLoc) {
                statusEl.textContent = state.resolvedLoc.label;
            } else if (val.trim()) {
                statusEl.textContent = `Hledám: ${val.trim()}`;
            } else {
                statusEl.textContent = 'Celá ČR';
            }

            // Zvýraznění aktivního rychlého čipu
            document.querySelectorAll('.city-chip').forEach(chip => {
                if (val && chip.textContent.toLowerCase().includes(stripAccents(val.split('(')[0]))) {
                    chip.classList.add('active');
                } else {
                    chip.classList.remove('active');
                }
            });

            renderCatalog();
        }

        function setQuickLocation(preset) {
            document.getElementById('location-input').value = preset;
            handleLocationChange();
            if (preset) {
                showToast(`Výchozí lokalita: ${preset}`);
            }
        }

        function handleDistanceChange() {
            const val = parseInt(document.getElementById('distance-slider').value, 10);
            state.maxDistance = val;
            document.getElementById('distance-value').textContent = `do ${val} km`;
            renderCatalog();
        }

        function setOfferFilter(offerType) {
            state.offerType = offerType;
            document.querySelectorAll('.seg-btn').forEach(btn => {
                if (btn.dataset.offer === offerType) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
            renderCatalog();
        }

        function resetAllFilters() {
            state.locationQuery = '';
            state.resolvedLoc = null;
            state.maxDistance = 40;
            state.offerType = 'all';
            state.colors = [];
            state.styles = [];
            state.materials = [];
            state.uses = [];

            document.getElementById('location-input').value = '';
            document.getElementById('clear-loc-btn').classList.remove('visible');
            document.getElementById('location-status').textContent = 'Celá ČR';
            document.getElementById('distance-slider').value = '40';
            document.getElementById('distance-value').textContent = 'do 40 km';
            document.getElementById('search-input').value = '';
            document.querySelectorAll('.city-chip').forEach(c => c.classList.remove('active'));

            setOfferFilter('all');
            syncFilterPillsUI();
            renderCatalog();
        }

        function getDistanceForItem(item) {
            if (!state.resolvedLoc) return null;
            return haversineKm(state.resolvedLoc.lat, state.resolvedLoc.lon, item.lat, item.lon);
        }

        /* =====================================================================
           8. VYKRESLENÍ KATALOGU INZERÁTŮ
           ===================================================================== */
        function renderCatalog() {
            const searchQuery = stripAccents(document.getElementById('search-input').value);
            const sortBy = document.getElementById('sort-select').value;

            const filtered = listings.filter(item => {
                // Lokalita & vzdálenost
                if (state.resolvedLoc) {
                    const dist = getDistanceForItem(item);
                    if (dist !== null && dist > state.maxDistance) return false;
                } else if (state.locationQuery.trim() !== '') {
                    const q = stripAccents(state.locationQuery);
                    const qDigits = q.replace(/\s+/g, '');
                    const itemCity = stripAccents(item.city);
                    const itemZip = item.zip.replace(/\s+/g, '');
                    if (!itemCity.includes(q) && !itemZip.startsWith(qDigits)) return false;
                }

                // Typ nabídky
                if (state.offerType !== 'all' && item.type !== state.offerType) return false;

                // Fulltext
                if (searchQuery) {
                    const blob = stripAccents(`${item.title} ${item.description} ${item.city} ${item.zip} ${item.styles.join(' ')} ${item.materials.join(' ')}`);
                    if (!blob.includes(searchQuery)) return false;
                }

                // Multi-choice tagy (OR uvnitř skupiny, AND mezi skupinami)
                if (state.colors.length > 0 && !state.colors.some(c => item.colors.includes(c))) return false;
                if (state.styles.length > 0 && !state.styles.some(s => item.styles.includes(s))) return false;
                if (state.materials.length > 0 && !state.materials.some(m => item.materials.includes(m))) return false;
                if (state.uses.length > 0 && !state.uses.some(u => item.uses.includes(u))) return false;

                return true;
            });

            // Řazení
            filtered.sort((a, b) => {
                if (sortBy === 'price-asc') return a.price - b.price;
                if (sortBy === 'price-desc') return b.price - a.price;
                if (sortBy === 'distance' && state.resolvedLoc) {
                    return (getDistanceForItem(a) ?? 999) - (getDistanceForItem(b) ?? 999);
                }
                return (b.isTop ? 1 : 0) - (a.isTop ? 1 : 0);
            });

            // Aktualizace počítadel
            document.getElementById('header-count').textContent = listings.length;
            const countLabel = filtered.length === 1 ? '1 položka' : filtered.length < 5 ? `${filtered.length} položky` : `${filtered.length} položek`;
            document.getElementById('results-count').textContent = `(${countLabel})`;

            // Lišta aktivních tagů
            renderActiveTagsStrip();

            const grid = document.getElementById('cards-grid');
            const empty = document.getElementById('empty-state');

            if (filtered.length === 0) {
                grid.innerHTML = '';
                empty.classList.add('visible');
                return;
            }

            empty.classList.remove('visible');

            grid.innerHTML = filtered.map(item => {
                const dist = getDistanceForItem(item);
                const typeClass = item.type === 'Půjčení' ? 'type-pujceni' : item.type === 'Kompletní svatba' ? 'type-kompletni' : 'type-prodej';

                const bundleHtml = (item.type === 'Kompletní svatba' && item.bundleItems && item.bundleItems.length) ? `
                    <div class="bundle-preview">
                        <div class="bundle-preview-head">✦ Svatba v krabici obsahuje:</div>
                        <ul class="bundle-preview-list">
                            ${item.bundleItems.slice(0, 3).map(bi => `<li>${bi}</li>`).join('')}
                        </ul>
                    </div>
                ` : '';

                return `
                <article class="listing-card ${item.isTop ? 'is-top' : ''}" onclick="openDetailModal(${item.id})">
                    <div style="position: relative;">
                        ${getProductArtwork(item.motif, item.bg)}
                        <div class="card-badges-top">
                            <span class="type-badge ${typeClass}">${item.type}</span>
                            ${item.isTop ? '<span class="top-badge">★ TOP</span>' : ''}
                        </div>
                        <div class="card-location-pill">
                            <span class="location-tag">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#B98732" stroke-width="2.4"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                <span>${item.city} (${item.zip})</span>
                                ${dist !== null ? `<span class="location-dist">• ${dist === 0 ? 'v místě' : dist + ' km'}</span>` : ''}
                            </span>
                        </div>
                    </div>

                    <div class="card-body">
                        <h3 class="card-title">${item.title}</h3>
                        ${bundleHtml}
                        <div class="card-tags">
                            ${item.styles.slice(0, 2).map(s => `<span class="mini-tag">${s}</span>`).join('')}
                            ${item.materials.slice(0, 2).map(m => `<span class="mini-tag">${m}</span>`).join('')}
                            ${item.uses.slice(0, 1).map(u => `<span class="mini-tag">${u}</span>`).join('')}
                        </div>
                        <p class="card-excerpt">${item.description}</p>
                        <div class="card-footer">
                            <div class="price-block">
                                <span class="price-value">${item.price.toLocaleString('cs-CZ')} Kč</span>
                                ${item.priceUnit ? `<span class="price-unit">${item.priceUnit}</span>` : ''}
                            </div>
                            <span class="card-cta">Detail &amp; kontakt →</span>
                        </div>
                    </div>
                </article>
                `;
            }).join('');
        }

        function renderActiveTagsStrip() {
            const strip = document.getElementById('active-tags-strip');
            const selected = [
                ...state.colors.map(v => ({ g: 'colors', v })),
                ...state.styles.map(v => ({ g: 'styles', v })),
                ...state.materials.map(v => ({ g: 'materials', v })),
                ...state.uses.map(v => ({ g: 'uses', v }))
            ];

            if (selected.length === 0) {
                strip.innerHTML = '';
                return;
            }

            strip.innerHTML = selected.map(t => `
                <span class="active-chip">
                    <span>${t.v}</span>
                    <button type="button" onclick="toggleFilterTag('${t.g}', '${t.v}')" aria-label="Odebrat filtr ${t.v}">×</button>
                </span>
            `).join('');
        }

        /* =====================================================================
           9. DETAIL INZERÁTU A KONTAKT NA NEVĚSTU
           ===================================================================== */
        function openDetailModal(id) {
            const item = listings.find(l => l.id === id);
            if (!item) return;

            const dist = getDistanceForItem(item);
            const distText = dist !== null ? ` • ${dist === 0 ? 'přímo ve vašem městě' : dist + ' km od vás'}` : '';

            const bundleSection = (item.type === 'Kompletní svatba' && item.bundleItems && item.bundleItems.length) ? `
                <div class="bundle-preview" style="margin: 14px 0; padding: 14px 16px;">
                    <div class="bundle-preview-head" style="font-size: 0.82rem; margin-bottom: 6px;">✦ Kompletní obsah svatebního balíčku:</div>
                    <ul class="bundle-preview-list" style="font-size: 0.84rem;">
                        ${item.bundleItems.map(bi => `<li style="margin-bottom: 3px;">${bi}</li>`).join('')}
                    </ul>
                </div>
            ` : '';

            document.getElementById('detail-modal-body').innerHTML = `
                <div style="border-radius: var(--radius-md); overflow: hidden; margin-bottom: 18px; border: 1px solid var(--border-light);">
                    ${getProductArtwork(item.motif, item.bg)}
                </div>

                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 12px;">
                    <div>
                        <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gold); margin-bottom: 4px;">
                            ${item.type} • Nabízí ${item.seller}
                        </div>
                        <h3 style="font-family: var(--font-serif); font-size: 1.65rem; font-weight: 700; line-height: 1.2;">${item.title}</h3>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 1.45rem; font-weight: 700; color: var(--gold-hover);">${item.price.toLocaleString('cs-CZ')} Kč</div>
                        ${item.priceUnit ? `<div style="font-size: 0.78rem; color: var(--text-muted);">${item.priceUnit}</div>` : ''}
                    </div>
                </div>

                <div style="background: var(--bg-page); border: 1px solid var(--border-light); border-radius: var(--radius-sm); padding: 10px 14px; font-size: 0.85rem; font-weight: 600; margin-bottom: 14px;">
                    📍 Osobní předání: ${item.city} (${item.zip})${distText}
                </div>

                <p style="font-size: 0.92rem; color: var(--text-primary); line-height: 1.6; margin-bottom: 14px;">
                    ${item.description}
                </p>

                ${bundleSection}

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin: 16px 0 20px;">
                    <div style="background: var(--bg-page); padding: 10px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
                        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 5px;">Styl &amp; barvy</div>
                        <div class="card-tags" style="margin: 0;">
                            ${[...item.styles, ...item.colors].map(t => `<span class="mini-tag">${t}</span>`).join('')}
                        </div>
                    </div>
                    <div style="background: var(--bg-page); padding: 10px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
                        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 5px;">Materiál &amp; využití</div>
                        <div class="card-tags" style="margin: 0;">
                            ${[...item.materials, ...item.uses].map(t => `<span class="mini-tag">${t}</span>`).join('')}
                        </div>
                    </div>
                </div>

                <form onsubmit="sendMessageToSeller(event, '${item.seller}')" style="border-top: 1px solid var(--border-light); padding-top: 18px;">
                    <h4 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 700; margin-bottom: 10px;">Napsat zprávu (${item.seller})</h4>
                    <div class="form-grid" style="margin-bottom: 10px;">
                        <input required type="text" class="form-input" placeholder="Vaše jméno">
                        <input required type="text" class="form-input" placeholder="Váš e-mail nebo telefon">
                        <textarea required rows="2" class="form-textarea form-full">Dobrý den, mám zájem o „${item.title}“. Kdy by bylo možné osobní vyzvednutí v lokalitě ${item.city} (${item.zip})?</textarea>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 10px;">
                        <button type="button" class="btn-outline-gold" onclick="closeModal('detail-modal')">Zavřít</button>
                        <button type="submit" class="btn-gold">Odeslat zprávu nevěstě</button>
                    </div>
                </form>
            `;

            openModal('detail-modal');
        }

        function sendMessageToSeller(e, seller) {
            e.preventDefault();
            closeModal('detail-modal');
            showToast(`Zpráva pro ${seller} byla úspěšně odeslána!`);
        }

        /* =====================================================================
           10. PŘIDÁNÍ NOVÉHO INZERÁTU
           ===================================================================== */
        function renderModalCheckboxes() {
            document.getElementById('form-colors').innerHTML = TAG_CONFIG.colors.map(c => `
                <label class="check-pill-label"><input type="checkbox" name="f-color" value="${c.label}"><span>${c.label}</span></label>
            `).join('');

            document.getElementById('form-styles').innerHTML = TAG_CONFIG.styles.map(s => `
                <label class="check-pill-label"><input type="checkbox" name="f-style" value="${s}"><span>${s}</span></label>
            `).join('');

            document.getElementById('form-materials').innerHTML = TAG_CONFIG.materials.map(m => `
                <label class="check-pill-label"><input type="checkbox" name="f-material" value="${m}"><span>${m}</span></label>
            `).join('');

            document.getElementById('form-uses').innerHTML = TAG_CONFIG.uses.map(u => `
                <label class="check-pill-label"><input type="checkbox" name="f-use" value="${u}"><span>${u}</span></label>
            `).join('');
        }

        function toggleNewBundleField() {
            const type = document.getElementById('new-type').value;
            document.getElementById('new-bundle-wrap').style.display = type === 'Kompletní svatba' ? 'flex' : 'none';
        }

        function openAddModal() {
            openModal('add-modal');
        }

        function submitNewListing(e) {
            e.preventDefault();

            const title = document.getElementById('new-title').value.trim();
            const type = document.getElementById('new-type').value;
            const price = parseInt(document.getElementById('new-price').value, 10) || 0;
            const city = document.getElementById('new-city').value.trim();
            const zipRaw = document.getElementById('new-zip').value.trim();
            const seller = document.getElementById('new-seller').value.trim() || 'Nevěsta z okolí';
            const desc = document.getElementById('new-desc').value.trim() || 'Krásná svatební výzdoba připravená k osobnímu předání.';
            const isTop = document.getElementById('new-top').checked;

            const bundleRaw = document.getElementById('new-bundle-items').value.trim();
            const bundleItems = (type === 'Kompletní svatba' && bundleRaw)
                ? bundleRaw.split(',').map(s => s.trim()).filter(Boolean)
                : (type === 'Kompletní svatba' ? ['Kompletní sada dekorací pro celou svatbu'] : []);

            const resolved = resolveLocation(zipRaw) || resolveLocation(city) || { lat: 49.5231, lon: 16.2615 };

            const colors = Array.from(document.querySelectorAll('input[name="f-color"]:checked')).map(i => i.value);
            const styles = Array.from(document.querySelectorAll('input[name="f-style"]:checked')).map(i => i.value);
            const materials = Array.from(document.querySelectorAll('input[name="f-material"]:checked')).map(i => i.value);
            const uses = Array.from(document.querySelectorAll('input[name="f-use"]:checked')).map(i => i.value);

            listings.unshift({
                id: Date.now(),
                title,
                type,
                price,
                priceUnit: type === 'Půjčení' ? '/ víkend' : '',
                bundleItems,
                city,
                zip: formatZip(zipRaw),
                lat: resolved.lat,
                lon: resolved.lon,
                seller,
                isTop,
                motif: type === 'Kompletní svatba' ? 'bundle' : 'vases',
                bg: 'linear-gradient(135deg, #FBF6EE 0%, #EFE6D5 100%)',
                colors: colors.length ? colors : ['Bílá & slonovinová'],
                styles: styles.length ? styles : ['univerzální'],
                materials: materials.length ? materials : ['sklo'],
                uses: uses.length ? uses : ['na hostinu'],
                description: desc
            });

            document.getElementById('add-listing-form').reset();
            toggleNewBundleField();
            closeModal('add-modal');
            switchView('bazar');
            renderCatalog();
            showToast(isTop ? 'Inzerát byl zveřejněn a zvýrazněn jako TOP!' : 'Váš inzerát byl úspěšně přidán do katalogu!');
        }

        /* =====================================================================
           11. GARÁŽOVÉ VÝPRODEJE NAŽIVO
           ===================================================================== */
        function renderGarageEvents() {
            document.getElementById('garage-grid').innerHTML = garageEvents.map(ev => {
                const occupied = ev.totalTables - ev.freeTables;
                const pct = Math.round((occupied / ev.totalTables) * 100);

                return `
                <article class="event-card">
                    <div>
                        <span class="event-date-pill">📅 ${ev.date}</span>
                        <h3 style="font-family: var(--font-serif); font-size: 1.4rem; font-weight: 700; line-height: 1.25; margin-bottom: 6px;">${ev.title}</h3>
                        <p style="font-size: 0.85rem; color: var(--text-secondary);">${ev.desc}</p>
                        <div class="event-meta">
                            <div><strong>Místo:</strong> ${ev.venue}, ${ev.city}</div>
                            <div><strong>Vstupné pro kupující:</strong> ${ev.entry}</div>
                        </div>
                    </div>

                    <div>
                        <div class="tables-meter">
                            <span>Volné prodejní stoly</span>
                            <span style="color: var(--gold-hover);">${ev.freeTables} z ${ev.totalTables} volných</span>
                        </div>
                        <div class="meter-bar">
                            <div class="meter-fill" style="width: ${pct}%;"></div>
                        </div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <button type="button" class="btn-gold" style="flex: 1;" ${ev.freeTables === 0 ? 'disabled' : ''} onclick="openBookingModal('${ev.id}')">
                                ${ev.freeTables > 0 ? 'Rezervovat stůl (290 Kč)' : 'Stoly obsazeny'}
                            </button>
                            <button type="button" class="btn-outline-gold" onclick="showToast('Přihláška kupující na akci „${ev.title}“ uložena!')">
                                Přijdu nakoupit
                            </button>
                        </div>
                    </div>
                </article>
                `;
            }).join('');
        }

        function openBookingModal(eventId) {
            const ev = garageEvents.find(e => e.id === eventId);
            if (!ev) return;
            bookingEventId = eventId;
            document.getElementById('booking-event-summary').textContent = `${ev.title} • ${ev.date} (${ev.venue})`;
            openModal('booking-modal');
        }

        function confirmTableBooking(e) {
            e.preventDefault();
            const ev = garageEvents.find(item => item.id === bookingEventId);
            if (ev && ev.freeTables > 0) {
                ev.freeTables -= 1;
                renderGarageEvents();
            }
            closeModal('booking-modal');
            showToast('Prodejní stůl rezervován! Potvrzení jsme odeslali na e-mail.');
        }

        /* =====================================================================
           11B. POPTÁVKA SVATEBNÍHO MÍSTA NA USPOŘÁDÁNÍ GARÁŽOVÉHO VÝPRODEJE
           ===================================================================== */
        const PLATFORM_OWNER_EMAIL = 'stodoly@moderninevesta.cz';
        let lastVenueSummaryText = '';

        function openVenueModal() {
            document.getElementById('venue-host-form').reset();
            document.getElementById('venue-form-container').style.display = 'block';
            document.getElementById('venue-confirmation-container').style.display = 'none';
            openModal('venue-modal');
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        async function submitVenueProposal(e) {
            e.preventDefault();

            const organizer = document.getElementById('venue-organizer').value.trim();
            const phone = document.getElementById('venue-phone').value.trim() || 'Neuvedeno';
            const email = document.getElementById('venue-email').value.trim();
            const place = document.getElementById('venue-place').value.trim();
            const vendors = document.getElementById('venue-vendors').value.trim() || 'Bez doprovodného programu / neuvedeno';
            const message = document.getElementById('venue-message').value.trim() || 'Bez dalších poznámek';

            const fullSummary = [
                `Jméno organizátora: ${organizer}`,
                `Telefon: ${phone}`,
                `Email: ${email}`,
                `Místo výprodeje (název objektu, adresa): ${place}`,
                `Dodavatelé profíci (doprovodný program): ${vendors}`,
                `Vaše zpráva (představa, požadavky, podmínky): ${message}`
            ].join('\n');

            lastVenueSummaryText = fullSummary;

            const ownerSubject = `Nová poptávka garážového výprodeje – ${place}`;
            const ownerBody = `Dobrý den,\n\npřišla nová poptávka na uspořádání Svatebního garážového výprodeje přes platformu Moderní nevěsta:\n\n${fullSummary}\n\n---\nOdesláno z webu Moderní nevěsta – Lokální svatební bazar & garážáky`;

            const organizerSubject = `Potvrzení poptávky: Svatební garážový výprodej – ${place}`;
            const organizerBody = `Dobrý den, ${organizer},\n\nděkujeme za váš zájem uspořádat Svatební garážový výprodej ve vašem prostoru! Níže posíláme kompletní rekapitulaci vaší poptávky. Brzy se vám ozveme s návrhem termínu a dalšími kroky.\n\n${fullSummary}\n\nS pozdravem,\nTým Moderní nevěsta`;

            /* =================================================================
               MÍSTO PRO OSTRÉ NAPOJENÍ NA E-MAILOVOU SLUŽBU / WEBHOOK
               (např. Formspree, EmailJS, Resend nebo vlastní backend API):
               -----------------------------------------------------------------
               try {
                   await fetch('https://formspree.io/f/VASE_FORM_ID', {
                       method: 'POST',
                       headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                       body: JSON.stringify({
                           to_owner: PLATFORM_OWNER_EMAIL,
                           reply_to: email,
                           organizer,
                           phone,
                           email,
                           place,
                           vendors,
                           message,
                           owner_email_text: ownerBody,
                           organizer_copy_text: organizerBody
                       })
                   });
               } catch (err) {
                   console.error('Chyba při odesílání na e-mailový webhook:', err);
               }
               ================================================================= */

            // Nastavení mailto: odkazu pro přímé odeslání s kopií (CC) organizátorovi
            const mailtoHref = `mailto:${encodeURIComponent(PLATFORM_OWNER_EMAIL)}?cc=${encodeURIComponent(email)}&subject=${encodeURIComponent(ownerSubject)}&body=${encodeURIComponent(ownerBody)}`;
            document.getElementById('venue-mailto-link').href = mailtoHref;

            // Vykreslení náhledu obou e-mailů v modálním okně
            document.getElementById('venue-emails-summary').innerHTML = `
                <div class="email-preview-card">
                    <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gold-hover); margin-bottom: 6px;">
                        1. E-mail pro majitele platformy Moderní nevěsta
                    </div>
                    <div class="email-preview-meta">
                        <div><strong>Komu:</strong> ${escapeHtml(PLATFORM_OWNER_EMAIL)}</div>
                        <div><strong>Odpovědět komu (Reply-To):</strong> ${escapeHtml(email)}</div>
                        <div><strong>Předmět:</strong> ${escapeHtml(ownerSubject)}</div>
                    </div>
                    <div class="email-preview-content">${escapeHtml(ownerBody)}</div>
                </div>

                <div class="email-preview-card" style="margin-bottom: 0;">
                    <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gold-hover); margin-bottom: 6px;">
                        2. Potvrzovací kopie e-mailu pro organizátora svatebního místa
                    </div>
                    <div class="email-preview-meta">
                        <div><strong>Komu:</strong> ${escapeHtml(email)}</div>
                        <div><strong>Od:</strong> ${escapeHtml(PLATFORM_OWNER_EMAIL)}</div>
                        <div><strong>Předmět:</strong> ${escapeHtml(organizerSubject)}</div>
                    </div>
                    <div class="email-preview-content">${escapeHtml(organizerBody)}</div>
                </div>
            `;

            document.getElementById('venue-form-container').style.display = 'none';
            document.getElementById('venue-confirmation-container').style.display = 'block';
            showToast(`E-maily byly připraveny pro ${PLATFORM_OWNER_EMAIL} i ${email}`);
        }

        function copyVenueSummary() {
            if (!lastVenueSummaryText) return;
            const tempArea = document.createElement('textarea');
            tempArea.value = lastVenueSummaryText;
            tempArea.style.position = 'fixed';
            tempArea.style.opacity = '0';
            document.body.appendChild(tempArea);
            tempArea.select();
            try {
                document.execCommand('copy');
                showToast('Kompletní výpis údajů zkopírován do schránky!');
            } catch (err) {
                showToast('Nepodařilo se zkopírovat text.');
            }
            document.body.removeChild(tempArea);
        }

        /* =====================================================================
           12. POMOCNÉ FUNKCE PRO MODÁLY A TOAST
           ===================================================================== */
        function openModal(id) {
            document.getElementById(id).classList.add('open');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        let toastTimer = null;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = msg;
            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('show'), 3400);
        }

        window.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
