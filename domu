            { name: 'Ostrava', aliases: ['ostrava'], zip: '70200', lat: 49.8209, lon: 18.2625 }
        ];

        const ZIP_PREFIX_FALLBACK = [
            { prefix: '59', city: 'Bystřice nad Pernštejnem' },
            { prefix: '58', city: 'Jihlava' },
            { prefix: '6', city: 'Brno' },
            { prefix: '1', city: 'Praha' },
            { prefix: '2', city: 'Praha' },
            { prefix: '77', city: 'Olomouc' },
            { prefix: '78', city: 'Olomouc' },
            { prefix: '79', city: 'Olomouc' },
            { prefix: '50', city: 'Hradec Králové' },
            { prefix: '37', city: 'České Budějovice' },
            { prefix: '30', city: 'Plzeň' },
            { prefix: '31', city: 'Plzeň' },
            { prefix: '32', city: 'Plzeň' },
            { prefix: '53', city: 'Pardubice' },
            { prefix: '76', city: 'Zlín' },
            { prefix: '46', city: 'Liberec' },
            { prefix: '70', city: 'Ostrava' }
        ];

        function stripAccents(str) {
            return String(str).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
        }

        function formatZip(zip) {
            const clean = String(zip).replace(/\s+/g, '');
            return clean.length === 5 ? `${clean.slice(0, 3)} ${clean.slice(3)}` : zip;
        }

        function resolveLocation(query) {
            if (!query || !query.trim()) return null;
            const raw = query.trim();

            // 1. Kontrola 5místného PSČ (např. "593 01" nebo "59301")
            const zipMatch = raw.match(/(\d{3})\s*(\d{2})/);
            if (zipMatch) {
                const digits = `${zipMatch[1]}${zipMatch[2]}`;
                const exact = CZ_LOCATIONS.find(l => l.zip === digits);
                if (exact) {
                    return { label: `${exact.name} (${formatZip(digits)})`, lat: exact.lat, lon: exact.lon };
                }
                const pref = ZIP_PREFIX_FALLBACK.find(p => digits.startsWith(p.prefix));
                if (pref) {
                    const ref = CZ_LOCATIONS.find(c => c.name === pref.city);
                    if (ref) {
                        return { label: `PSČ ${formatZip(digits)} (${ref.name})`, lat: ref.lat, lon: ref.lon };
                    }
                }
            }

            // 2. Kontrola názvu města
            const clean = stripAccents(raw.replace(/\(.*?\)/g, ''));
            if (!clean) return null;

            const found = CZ_LOCATIONS.find(l =>
                stripAccents(l.name).includes(clean) ||
                clean.includes(stripAccents(l.name)) ||
                l.aliases.some(a => a.includes(clean) || clean.includes(a))
            );

            return found ? { label: `${found.name} (${formatZip(found.zip)})`, lat: found.lat, lon: found.lon } : null;
        }

        function haversineKm(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) ** 2 +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon / 2) ** 2;
            return Math.round(R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
        }

