            { name: 'Hradec Králové', aliases: ['hradec kralove', 'hradec'], zip: '50002', lat: 50.2104, lon: 15.8252 },
            { name: 'České Budějovice', aliases: ['ceske budejovice', 'budejovice'], zip: '37001', lat: 48.9745, lon: 14.4743 },
            { name: 'Plzeň', aliases: ['plzen'], zip: '30100', lat: 49.7384, lon: 13.3736 },
